<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimaryDark">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/ui_primary</item>
        <item name="colorOnPrimary">@color/ui_on_primary</item>
        <item name="colorSecondaryContainer">@color/ui_key_special</item>
        <item name="colorOnSecondaryContainer">@color/ui_text</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="colorOnSurfaceVariant">@color/ui_muted</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MyEditText" parent="Theme.AppCompat.Light">
        <item name="colorControlNormal">@android:color/darker_gray</item>
        <item name="colorControlActivated">@android:color/holo_orange_dark</item>
    </style>
    <!-- 紧凑键帽：清除 M3 默认最小宽度和内边距，避免横屏文字被挤压。 -->
    <style name="Widget.BluetoothConnect.Key" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="backgroundTint">@color/ui_key</item>
        <item name="android:focusable">false</item>
    </style>
    <style name="Widget.BluetoothConnect.SpecialKey" parent="Widget.BluetoothConnect.Key">
        <item name="backgroundTint">@color/keyboard_special_tint</item>
        <item name="android:textColor">@color/keyboard_special_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
