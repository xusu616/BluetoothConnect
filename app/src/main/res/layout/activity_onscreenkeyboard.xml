<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:orientation="vertical" android:background="@color/ui_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/keyboard" android:text="输入法" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/ctrl" android:text="Ctrl" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/alt" android:text="Alt" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/shift" android:text="Shift" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/window" android:text="Win" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/esc" android:text="Esc" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/tab" android:text="Tab" />
