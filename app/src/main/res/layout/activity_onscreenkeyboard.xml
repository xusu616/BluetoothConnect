<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/up" android:text="↑" />
<com.google.android.material.button.MaterialButton style="@style/Widget.BluetoothConnect.SpecialKey" android:id="@+id/right" android:text="→" />
</LinearLayout>
</LinearLayout>
